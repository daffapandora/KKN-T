# ==============================================================================
# Kemitir Tangguh Bencana - Environment Configuration Template
# Copy this file to .env and replace with appropriate values.
# NEVER commit sensitive production secrets into version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
TZ=Asia/Jakarta

# Application Ports
API_PORT=4000
WEB_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# PostgreSQL + PostGIS (Docker Compose and Application)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kemitir_gis
POSTGRES_USER=kemitir_user
POSTGRES_PASSWORD=kemitir_secure_password_dev_2026
DATABASE_URL=postgresql://kemitir_user:kemitir_secure_password_dev_2026@localhost:5432/kemitir_gis?schema=public

# Database pool tuning (2 vCPU / 4 GB VPS)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication & Security
JWT_SECRET=super_secret_jwt_dev_key_at_least_32_characters_long_kemitir_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_dev_key_kemitir_2026_change_in_prod
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_dev_key_kemitir_32_characters_long
PHONE_PEPPER=kemitir_phone_pepper_salt_2026_sumowono
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BCRYPT_OR_ARGON_SALT_ROUNDS=12

# Anti-Spam & Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=60
REPORTS_RATE_LIMIT_PER_HOUR=5
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare R2 Storage (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kemitir-media-dev
R2_PUBLIC_DOMAIN=https://media.desakemitir.id

# Basemap and Tiles
MAPBOX_ACCESS_TOKEN=pk.optional_mapbox_token_for_satellite_basemap
DEFAULT_MAP_CENTER_LNG=110.3155
DEFAULT_MAP_CENTER_LAT=-7.2285
DEFAULT_MAP_ZOOM=14
